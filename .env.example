# LLM 提供方: openai | doubao
LLM_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 豆包 Doubao / 火山引擎 Ark 配置
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-251015

# 输出目录（生成的项目存放路径）
OUTPUT_DIR=./generated_projects

# 日志文件目录（用于排查卡住、超时等问题，tail -f logs/autodev.log 可实时查看）
LOG_DIR=./logs

# 日志级别
LOG_LEVEL=INFO

# LLM 超时秒数（防止无限等待）
LLM_TIMEOUT=120

# 是否使用规划 Agent（false=跳过规划，用旧版整体生成，更快）
USE_PLANNING=false
